# Local Supabase server access
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Never rename this to NEXT_PUBLIC_FRED_API_KEY.
FRED_API_KEY=

# Server-side only. Required for the GOLD (XAU/USD spot) daily sync.
ALPHA_VANTAGE_API_KEY=

# yfinance needs no API key. Override only when `python` is not on PATH.
YFINANCE_PYTHON_PATH=python

# Optional writable cache directory. Defaults to .cache/yfinance.
YFINANCE_CACHE_DIR=.cache/yfinance
